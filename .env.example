BOT_TOKEN=your_telegram_bot_token

# Supabase → Project Settings → Database → Connection string (URI)
# Replace postgresql:// with postgresql+asyncpg://
# User: postgres.YOUR_PROJECT_REF (not postgres.[ref])
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API → Project URL (no square brackets)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Settings → API Keys → Secret keys → Create / Reveal (sb_secret_...)
# НЕ publishable. Legacy JWT service_role теж підходить (eyJ...), якщо ще увімкнений.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=visit-photos

LOG_LEVEL=INFO

# Веб-панель (python web_main.py)
# Менеджери: цей пароль + свій Telegram ID (обовʼязково)
DASHBOARD_PASSWORD=team_shared_password
# Керівник: окремий пароль, Telegram ID не вводить
DASHBOARD_ADMIN_PASSWORD=director_only_password
# Адмін у БД при вході лише паролем (Андрій Вовнянко — admin + регіональний у полі)
DASHBOARD_ADMIN_TELEGRAM_ID=123456789
# Опційно: окремий ключ сесії (інакше генерується з пароля)
# DASHBOARD_SECRET_KEY=
WEB_PORT=8000
# Міграція історії переміщень: database/migrations/010_stand_transfers.sql
